{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.invalid/schemas/minimum-version-evidence.schema.json",
  "title": "ParchMint minimum platform version evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format-version", "platform", "minimum-version", "result", "runner",
    "observed-at", "checks", "details"
  ],
  "properties": {
    "format-version": { "const": 1 },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "minimum-version": { "type": "string", "minLength": 1 },
    "result": { "const": "passed" },
    "runner": { "type": "string", "minLength": 1 },
    "observed-at": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "contains": { "const": "install" },
      "minContains": 1,
      "items": { "enum": ["install", "launch", "native-ui"] },
      "minItems": 3,
      "uniqueItems": true
    },
    "details": { "type": "string", "minLength": 1 }
  }
}
