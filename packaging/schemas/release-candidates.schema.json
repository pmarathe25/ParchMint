{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.invalid/schemas/release-candidates.schema.json",
  "title": "ParchMint release candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format-version",
    "release-version",
    "source-revision",
    "dependency-notices",
    "dependency-notices-sha256",
    "sbom",
    "sbom-sha256",
    "provenance",
    "provenance-sha256",
    "release-gate-evidence",
    "release-gate-evidence-sha256",
    "platform"
  ],
  "properties": {
    "format-version": { "const": 1 },
    "release-version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
    "source-revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dependency-notices": { "$ref": "#/$defs/path" },
    "dependency-notices-sha256": { "$ref": "#/$defs/sha256" },
    "sbom": { "$ref": "#/$defs/path" },
    "sbom-sha256": { "$ref": "#/$defs/sha256" },
    "provenance": { "$ref": "#/$defs/path" },
    "provenance-sha256": { "$ref": "#/$defs/sha256" },
    "release-gate-evidence": { "$ref": "#/$defs/path" },
    "release-gate-evidence-sha256": { "$ref": "#/$defs/sha256" },
    "platform": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\r\\n]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "architecture", "minimum-version", "package", "package-sha256",
        "signature", "notarization", "install-evidence", "install-evidence-sha256",
        "launch-evidence", "launch-evidence-sha256", "upgrade-evidence",
        "upgrade-evidence-sha256", "uninstall-evidence", "uninstall-evidence-sha256",
        "native-ui-validation"
      ],
      "properties": {
        "name": { "enum": ["windows", "macos", "linux"] },
        "architecture": { "type": "string", "minLength": 1 },
        "minimum-version": { "type": "string", "minLength": 1 },
        "package": { "$ref": "#/$defs/path" },
        "package-sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "enum": ["required", "not-applicable"] },
        "signature-verifier": { "type": "string", "minLength": 1 },
        "signature-evidence": { "$ref": "#/$defs/path" },
        "signature-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "notarization": { "enum": ["required", "not-applicable"] },
        "notarization-verifier": { "type": "string", "minLength": 1 },
        "notarization-evidence": { "$ref": "#/$defs/path" },
        "notarization-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "install-evidence": { "$ref": "#/$defs/path" },
        "install-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "launch-evidence": { "$ref": "#/$defs/path" },
        "launch-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "upgrade-evidence": { "$ref": "#/$defs/path" },
        "upgrade-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "uninstall-evidence": { "$ref": "#/$defs/path" },
        "uninstall-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "native-ui-validation": { "enum": ["passed", "deferred"] },
        "native-ui-evidence": { "$ref": "#/$defs/path" },
        "native-ui-evidence-sha256": { "$ref": "#/$defs/sha256" },
        "native-ui-deferred-reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
