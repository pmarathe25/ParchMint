{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.invalid/schemas/dependency-notices.schema.json",
  "title": "ParchMint deterministic dependency notices",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "generated-by", "package"],
  "properties": {
    "format-version": { "const": 1 },
    "generated-by": { "const": "cargo parchmint-ci release notices" },
    "package": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license", "notice"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "notice": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
