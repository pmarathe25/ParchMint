{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.invalid/schemas/installer-evidence.schema.json",
  "title": "ParchMint installer and native validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format-version", "kind", "platform", "release-version", "source-revision",
    "package-sha256", "result", "runner", "observed-at", "details"
  ],
  "properties": {
    "format-version": { "const": 1 },
    "kind": { "enum": ["signature", "notarization", "install", "launch", "upgrade", "uninstall", "native-ui"] },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "release-version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
    "source-revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package-sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": { "const": "passed" },
    "runner": { "type": "string", "minLength": 1 },
    "observed-at": { "type": "string", "format": "date-time" },
    "details": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["clipboard", "dialogs", "menus"] }
    },
    "tool": { "type": "string", "minLength": 1 },
    "identity": { "type": "string", "minLength": 1 },
    "ticket-id": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "signature" } } },
      "then": { "required": ["tool", "identity"] }
    },
    {
      "if": { "properties": { "kind": { "const": "notarization" } } },
      "then": { "required": ["tool", "ticket-id"] }
    },
    {
      "if": { "properties": { "kind": { "const": "native-ui" } } },
      "then": {
        "required": ["checks"],
        "properties": {
          "checks": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  ]
}
