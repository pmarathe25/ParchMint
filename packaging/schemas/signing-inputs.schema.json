{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.invalid/schemas/signing-inputs.schema.json",
  "title": "ParchMint native signing and notarization inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "platform", "package-sha256", "signing"],
  "properties": {
    "format-version": { "const": 1 },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "package-sha256": { "$ref": "#/$defs/sha256" },
    "signing": { "$ref": "#/$defs/signing" },
    "notarization": { "$ref": "#/$defs/notarization" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environmentName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "identity", "credential-environment"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "credential-environment": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/environmentName" }
        },
        "timestamp-url": { "type": "string", "format": "uri" }
      }
    },
    "notarization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "profile-environment"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "profile-environment": { "$ref": "#/$defs/environmentName" },
        "staple": { "const": true }
      }
    }
  }
}
