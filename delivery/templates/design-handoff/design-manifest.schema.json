{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchmint.local/schemas/design-manifest-v2.json",
  "title": "ParchMint design handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff", "penpot", "themes", "appearance", "assets", "screens", "components", "prototype_flows", "platform_variants", "required_specs", "reference_coverage", "known_deviations", "checksums_file"],
  "properties": {
    "schema_version": {"const": 2},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "product_spec_version", "architecture_version", "design_brief_version", "handoff_contract_version", "created_at", "approved_at", "approved_by"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "approved"]},
        "product_spec_version": {"type": "string", "minLength": 1},
        "architecture_version": {"type": "string", "minLength": 1},
        "design_brief_version": {"type": "string", "minLength": 1},
        "handoff_contract_version": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "approved_at": {"type": "string"},
        "approved_by": {"type": "string"}
      }
    },
    "penpot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "file_id", "source_file", "pages"],
      "properties": {
        "version": {"type": "string"},
        "file_id": {"type": "string"},
        "source_file": {"type": "string", "pattern": "^[^/]+\\.penpot$"},
        "pages": {"type": "array", "items": {"type": "object"}}
      }
    },
    "themes": {
      "type": "object",
      "required": ["system_behavior", "sets", "dark_manuscript_surface", "semantic_role_parity_validated"],
      "properties": {
        "system_behavior": {"type": "object"},
        "sets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "penpot_theme_id", "token_files", "complete"],
            "properties": {
              "id": {"enum": ["light", "dark"]},
              "penpot_theme_id": {"type": "string"},
              "token_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "complete": {"type": "boolean"}
            }
          }
        },
        "dark_manuscript_surface": {"type": "boolean"},
        "semantic_role_parity_validated": {"type": "boolean"}
      }
    },
    "appearance": {
      "type": "object",
      "required": ["settings_screen_id", "options", "live_open_window_update_specified", "authored_content_unchanged_specified"],
      "properties": {
        "settings_screen_id": {"type": "string"},
        "options": {"const": ["system", "light", "dark"]},
        "live_open_window_update_specified": {"type": "boolean"},
        "authored_content_unchanged_specified": {"type": "boolean"}
      }
    },
    "assets": {"type": "array", "items": {"type": "object"}},
    "screens": {"type": "array", "items": {"type": "object"}},
    "components": {"type": "array", "items": {"type": "object"}},
    "prototype_flows": {"type": "array", "items": {"type": "object"}},
    "platform_variants": {"type": "array", "items": {"type": "object"}},
    "required_specs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_spec", "component_matrix", "screen_inventory", "keyboard_focus_map", "appearance_matrix", "cross_platform_variants", "asset_inventory", "font_inventory", "reference_fixtures", "known_deviations"],
      "patternProperties": {".*": {"type": "string", "minLength": 1}}
    },
    "reference_coverage": {
      "type": "object",
      "required": ["required_core_screens", "light_complete", "dark_complete"],
      "properties": {
        "required_core_screens": {"type": "array", "minItems": 9, "items": {"type": "string"}, "uniqueItems": true},
        "light_complete": {"type": "boolean"},
        "dark_complete": {"type": "boolean"}
      }
    },
    "known_deviations": {"type": "array", "items": {"type": "object"}},
    "checksums_file": {"type": "string", "const": "checksums.sha256"}
  }
}
